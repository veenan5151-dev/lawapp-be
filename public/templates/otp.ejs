<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8" />
        <title>OTP Verification</title>
    </head>
    <body style="margin: 0; padding: 0; background-color: #e2dbdb; font-family: Arial, sans-serif">
        <table width="100%" cellpadding="0" cellspacing="0" style="padding: 20px">
            <tr>
                <td align="center">
                    <table
                        width="500"
                        cellpadding="0"
                        cellspacing="0"
                        style="
                            background-color: #111;
                            border: 1px solid #333;
                            border-radius: 8px;
                            padding: 30px;
                        "
                    >
                        <!-- Header -->
                        <tr>
                            <td align="center" style="padding-bottom: 20px">
                                <h2 style="color: #fff; margin: 0; letter-spacing: 1px">
                                    EMAIL VERIFICATION
                                </h2>
                            </td>
                        </tr>

                        <!-- Message -->
                        <tr>
                            <td style="color: #ccc; font-size: 15px; line-height: 1.6">
                                <p style="margin: 0 0 10px">Hello,</p>
                                <p style="margin: 0 0 15px">
                                    Use the One-Time Password (OTP) below to complete your
                                    registration.
                                </p>
                            </td>
                        </tr>

                        <!-- OTP Box -->
                        <tr>
                            <td align="center" style="padding: 25px 0">
                                <div
                                    style="
                                        display: inline-block;
                                        padding: 15px 30px;
                                        border: 2px solid #fff;
                                        color: #fff;
                                        font-size: 28px;
                                        letter-spacing: 6px;
                                        font-weight: bold;
                                    "
                                >
                                    <%= otp %>
                                </div>
                            </td>
                        </tr>

                        <!-- Footer Message -->
                        <tr>
                            <td style="color: #888; font-size: 13px; line-height: 1.5">
                                <p style="margin: 0 0 10px">
                                    This OTP is valid for a limited time. Do not share it with
                                    anyone.
                                </p>
                                <p style="margin: 0">
                                    If you didn’t request this, you can safely ignore this email.
                                </p>
                            </td>
                        </tr>

                        <!-- Footer -->
                        <tr>
                            <td align="center" style="padding-top: 25px">
                                <p style="color: #555; font-size: 12px; margin: 0">
                                    © <%= new Date().getFullYear() %> LawApp
                                </p>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
